rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid && request.auth.token.email_verified == true; }
    function validId(id) { return id is string && id.matches('[A-Za-z0-9][A-Za-z0-9_-]{0,127}') && !id.matches('[dD][eE][mM][oO]-.*'); }
    function text(v, max) { return v is string && v.size() > 0 && v.size() <= max && v.matches('(?s).*\\S.*'); }
    function instant(v) { return v is int && v >= -62135596800000 && v <= 253402300799999; }
    function date(v) { return v is int && v >= -719162 && v <= 2932896; }
    function parent(uid, kind, id, deleted) {
      let path = /databases/$(database)/documents/users/$(uid)/$(kind)/$(id);
      return validId(id) && exists(path) && get(path).data.ownerUid == uid && (!get(path).data.deleted || deleted);
    }
    function patient(b) {
      return b.keys().hasAll(['nombre','edad','foto','notas','contactoEmergencia']) && b.keys().hasOnly(['nombre','edad','foto','notas','contactoEmergencia'])
        && text(b.nombre,120) && b.edad is int && b.edad >= 0 && b.edad <= 130 && b.foto == null
        && b.notas is string && b.notas.size() <= 4000 && text(b.contactoEmergencia,200);
    }
    function treatment(uid, b, deleted) {
      let h = b.horarios;
      let s = h.size();
      return b.keys().hasAll(['patientId','medicamento','dosis','horarios','compartimento','fechaInicio','fechaFin','activo'])
        && b.keys().hasOnly(['patientId','medicamento','dosis','horarios','compartimento','fechaInicio','fechaFin','activo','scheduleRevision'])
        && b.get('scheduleRevision',0) is int && b.get('scheduleRevision',0) >= 0 && b.get('scheduleRevision',0) < 1000000000
        && parent(uid,'patients',b.patientId,deleted) && text(b.medicamento,200) && text(b.dosis,200)
        && b.horarios is list && b.horarios.size() >= 1 && b.horarios.size() <= 24 && b.horarios.toSet().size() == b.horarios.size()
        && h.join(',').matches('([01][0-9]|2[0-3]):[0-5][0-9](,([01][0-9]|2[0-3]):[0-5][0-9]){0,23}')
        && h.join(',').split(',').size() == s
        && b.compartimento is int && b.compartimento >= 1 && b.compartimento <= 28
        && date(b.fechaInicio) && (b.fechaFin == null || (date(b.fechaFin) && b.fechaFin >= b.fechaInicio)) && b.activo is bool;
    }
    function doseMetadata(id,b) {
      let fields = ['origin','planKey','recordSource','recordedAt'];
      return !b.keys().hasAny(fields) || (b.keys().hasAll(fields)
        && b.origin in ['LEGACY','GENERATED','MANUAL'] && b.planKey is string
        && ((b.origin != 'GENERATED' && b.planKey == '') || (b.origin == 'GENERATED' && b.planKey.matches('[a-f0-9]{64}')
          && id == 'dose-' + hashing.sha256('v1|' + b.treatmentId + '|' + string(b.fechaHoraProgramada) + '|' + b.planKey).toHexString().lower()))
        && ((b.recordSource == null && b.recordedAt == null) || (b.recordSource == 'MANUAL'
          && instant(b.recordedAt) && b.recordedAt <= request.time.toMillis() && b.fechaHoraProgramada <= b.recordedAt
          && b.estado != 'PENDING' && (b.fechaHoraReal == null || b.fechaHoraReal <= b.recordedAt)
          && (b.estado != 'TAKEN' || b.fechaHoraReal <= b.fechaHoraProgramada))));
    }
    function dose(uid, id, b, deleted) {
      return b.keys().hasAll(['patientId','treatmentId','fechaHoraProgramada','fechaHoraReal','estado'])
        && b.keys().hasOnly(['patientId','treatmentId','fechaHoraProgramada','fechaHoraReal','estado','origin','planKey','recordSource','recordedAt','retiredByPlanKey'])
        && (!b.keys().hasAny(['retiredByPlanKey']) || (deleted && b.get('origin','LEGACY') == 'GENERATED' && b.estado == 'PENDING'
          && b.retiredByPlanKey is string && b.retiredByPlanKey.matches('[a-f0-9]{64}')))
        && parent(uid,'patients',b.patientId,deleted) && parent(uid,'treatments',b.treatmentId,deleted)
        && get(/databases/$(database)/documents/users/$(uid)/treatments/$(b.treatmentId)).data.body.patientId == b.patientId
        && instant(b.fechaHoraProgramada) && b.estado in ['PENDING','TAKEN','LATE','MISSED']
        && ((b.estado in ['TAKEN','LATE'] && instant(b.fechaHoraReal)) || (b.estado in ['PENDING','MISSED'] && b.fechaHoraReal == null))
        && (b.estado != 'LATE' || b.fechaHoraReal > b.fechaHoraProgramada) && doseMetadata(id,b);
    }
    function alert(uid,b,deleted) {
      return b.keys().hasAll(['patientId','tipo','mensaje','fecha','leida']) && b.keys().hasOnly(['patientId','tipo','mensaje','fecha','leida'])
        && parent(uid,'patients',b.patientId,deleted) && b.tipo in ['DOSIS_OMITIDA','STOCK_BAJO','BATERIA_BAJA','DESCONECTADO']
        && text(b.mensaje,2000) && instant(b.fecha) && b.leida is bool;
    }
    function profile(id,b,deleted) {
      return id == 'presentation' && !deleted && b.keys().hasAll(['profile']) && b.keys().hasOnly(['profile']) && b.profile in ['Usuario','Cuidador'];
    }
    function body(uid,kind,id,d) {
      return (kind == 'patients' && patient(d.body)) || (kind == 'treatments' && treatment(uid,d.body,d.deleted))
        || (kind == 'doseEvents' && dose(uid,id,d.body,d.deleted)) || (kind == 'alerts' && alert(uid,d.body,d.deleted))
        || (kind == 'preferences' && profile(id,d.body,d.deleted));
    }
    function envelope(uid,kind,id,d) {
      return validId(id) && d.keys().hasAll(['ownerUid','id','schemaVersion','revision','mutationId','deleted','updatedAt','body'])
        && d.keys().hasOnly(['ownerUid','id','schemaVersion','revision','mutationId','deleted','updatedAt','body'])
        && d.ownerUid == uid && d.id == id && d.schemaVersion is int && d.schemaVersion == 1
        && d.revision is int && d.revision > 0 && d.revision < 1000000000
        && d.mutationId is string && d.mutationId.matches('[A-Za-z0-9-]{1,128}') && d.deleted is bool
        && d.updatedAt is timestamp && d.updatedAt == request.time && d.body is map && body(uid,kind,id,d);
    }
    function identity(kind,d,old) {
      return (kind != 'treatments' && kind != 'doseEvents' && kind != 'alerts' || d.body.patientId == old.body.patientId)
        && (kind != 'doseEvents' || (d.body.treatmentId == old.body.treatmentId && d.body.fechaHoraProgramada == old.body.fechaHoraProgramada
          && d.body.get('origin','LEGACY') == old.body.get('origin','LEGACY') && d.body.get('planKey','') == old.body.get('planKey','')
          && (old.body.get('recordSource',null) == null || d.body.get('recordSource',null) == 'MANUAL')
          && (old.body.estado == 'PENDING' || d.body.estado != 'PENDING')));
    }
    function scheduleRevision(d,old) {
      let a=d.body;
      let b=old.body;
      let same=a.horarios.toSet() == b.horarios.toSet() && a.fechaInicio == b.fechaInicio && a.fechaFin == b.fechaFin && a.activo == b.activo;
      return a.get('scheduleRevision',0) == b.get('scheduleRevision',0) + (same ? 0 : 1);
    }
    match /users/{uid}/{kind}/{id} {
      allow read: if owner(uid) && kind in ['patients','treatments','doseEvents','alerts','preferences'];
      allow create: if owner(uid) && envelope(uid,kind,id,request.resource.data) && request.resource.data.revision == 1;
      allow update: if owner(uid) && envelope(uid,kind,id,request.resource.data)
        && request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.mutationId != resource.data.mutationId
        && (!resource.data.deleted || request.resource.data.deleted)
        && identity(kind,request.resource.data,resource.data)
        && (kind != 'treatments' || scheduleRevision(request.resource.data,resource.data));
      allow delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}

