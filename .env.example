# Web Django + Firebase. Configurar variables en el proceso; no se carga este archivo automáticamente.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=REEMPLAZAR_POR_UN_SECRETO_ALEATORIO_DE_AL_MENOS_50_CARACTERES
DJANGO_ALLOWED_HOSTS=dispensalud.site,www.dispensalud.site
DJANGO_CSRF_TRUSTED_ORIGINS=https://dispensalud.site,https://www.dispensalud.site
DJANGO_BEHIND_PROXY=1
DJANGO_DATA_DIR=/srv/dispensalud/shared
DISPENSALUD_HOSTED_DEMO=0
DISPENSALUD_FIREBASE_EMULATORS=0
# La configuración pública Firebase está centralizada en web/frontend/firebase-config.js.
# No se necesitan credenciales Admin, PostgreSQL ni Spring Boot.
