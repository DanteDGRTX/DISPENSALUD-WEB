# NEW /etc/nginx/sites-available/dispensalud-web. Enable AFTER the app-only cert exists.
# Does not claim dispensalud.site, www or any AgroSmart host.
server {
    listen 80;
    server_name app.dispensalud.site;
    access_log off;
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/dispensalud-web-acme;
        default_type text/plain;
        try_files $uri =404;
    }
    location / { return 301 https://app.dispensalud.site$request_uri; }
}
server {
    listen 443 ssl;
    server_name app.dispensalud.site;
    ssl_certificate /etc/letsencrypt/live/dispensalud-app-validation/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/dispensalud-app-validation/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    access_log off;
    error_log /var/log/nginx/dispensalud-web-error.log warn;
    client_max_body_size 2m;
    location /static/ {
        alias /srv/dispensalud-web/current/web/staticfiles/;
        add_header Cache-Control "public, max-age=300";
        add_header X-Content-Type-Options nosniff;
    }
    location / {
        proxy_pass http://127.0.0.1:8002;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header Forwarded "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 35s;
        proxy_send_timeout 30s;
        proxy_buffer_size 8k;
        proxy_buffers 4 8k;
        proxy_max_temp_file_size 0;
    }
}
