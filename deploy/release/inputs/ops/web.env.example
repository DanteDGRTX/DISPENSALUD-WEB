# Example only. No secret is distributed. create_env.py adds a fresh server key.
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=app.dispensalud.site,www.dispensalud.site,dispensalud.site
DJANGO_CSRF_TRUSTED_ORIGINS=https://app.dispensalud.site,https://www.dispensalud.site,https://dispensalud.site
DJANGO_BEHIND_PROXY=1
DJANGO_DATA_DIR=/srv/dispensalud-web/shared
DISPENSALUD_HOSTED_DEMO=0
DISPENSALUD_FIREBASE_EMULATORS=0
DISPENSALUD_REGISTRATION_ENABLED=0
# The last flag closes legacy registration only; Firebase registration is unchanged.
# DJANGO_SECRET_KEY is generated on the server, never filled into this example.
